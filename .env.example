# flux environment variables — copy to .env and fill in

# Provider credentials, one per registry entry in catalog/registry/providers.go
# (registry SortOrder). Or store them in the OS keychain — see
# docs/guides/CREDENTIAL-SETUP-FLOW.md. catalog/registry/docs_test.go keeps this
# block in sync with the registry.
AGNES_API_KEY=
AWS_SECRET_ACCESS_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
CANOPYWAVE_API_KEY=
CLINE_API_KEY=
CONCENTRATE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
MOONSHOT_API_KEY=
LONGCAT_API_KEY=
MINIMAX_PAYG_API_KEY=
MINIMAX_TOKEN_PLAN_API_KEY=
OPENAI_API_KEY=
OPENCODEGO_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
POOLSIDE_API_KEY=
VERTEX_ACCESS_TOKEN=
XAI_API_KEY=
XIAOMI_MIMO_PAYG_API_KEY=
XIAOMI_MIMO_TOKEN_PLAN_API_KEY=
ZAI_CODING_API_KEY=
ZAI_API_KEY=
STEP_API_KEY=
OPENGATEWAY_API_KEY=
FIREWORKS_API_KEY=

# Default model overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-5
GEMINI_MODEL=gemini-2.0-flash

# Optional: inject custom HTTP headers into every provider request
# FLUX_CUSTOM_HEADERS="X-Custom: value1\nX-Other: value2"

# Model catalog (dynamic discovery)
# FLUX_MODEL_CATALOG_URL=
# FLUX_MODEL_CATALOG_PATH=
# FLUX_MODEL_CATALOG_REFRESH=

# Local config/state directory
FLUX_CONFIG_DIR=~/.flux
